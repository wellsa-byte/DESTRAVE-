
export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (url.pathname === "/api/status" && request.method === "GET") {
      return Response.json({
        aiConfigured: Boolean(env.AI_API_KEY && env.AI_MODEL)
      });
    }

    if (url.pathname === "/api/ideas" && request.method === "POST") {
      let body;

      try {
        body = await request.json();
      } catch {
        return Response.json({ error: "Pedido inválido." }, { status: 400 });
      }

      const prompt = body?.prompt ?? "";
      const mode = body?.mode ?? "destravar";

      if (typeof prompt !== "string" || prompt.length > 6000) {
        return Response.json(
          { error: "Envie uma ideia de até 6000 caracteres." },
          { status: 400 }
        );
      }

      if (!env.AI_API_KEY || !env.AI_MODEL) {
        return Response.json(
          { error: "IA online não configurada. Use o modo local." },
          { status: 503 }
        );
      }

      try {
        const base = (env.AI_BASE_URL || "https://api.openai.com/v1")
          .replace(/\/$/, "");

        const response = await fetch(`${base}/chat/completions`, {
          method: "POST",
          headers: {
            Authorization: `Bearer ${env.AI_API_KEY}`,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            model: env.AI_MODEL,
            messages: [
              {
                role: "system",
                content: "Você é DESTRAVE, parceiro criativo de composição musical brasileira. Seja original, conciso e natural. Não reproduza letras existentes. Ofereça uma sacada principal, três caminhos curtos e um exercício prático."
              },
              {
                role: "user",
                content: `Modo: ${mode}\nIdeia: ${prompt || "Estou sem ideias. Surpreenda-me com um ponto de partida original."}`
              }
            ],
            temperature: 0.9
          })
        });

        const data = await response.json();

        if (!response.ok) {
          return Response.json(
            { error: "O provedor de IA não respondeu corretamente." },
            { status: 502 }
          );
        }

        return Response.json({
          text: data.choices?.[0]?.message?.content ||
            "Não consegui gerar uma resposta desta vez.",
          source: "ai"
        });
      } catch {
        return Response.json(
          { error: "Não foi possível conectar ao provedor de IA." },
          { status: 502 }
        );
      }
    }

    if (url.pathname.startsWith("/api/")) {
      return Response.json({ error: "Rota não encontrada." }, { status: 404 });
    }

    return env.ASSETS.fetch(request);
  }
};
